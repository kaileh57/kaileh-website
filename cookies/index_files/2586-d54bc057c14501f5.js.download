"use strict";(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[2586],{22586:function(e,a,n){n.d(a,{IP:function(){return findPersonByName}});let i=[{bylinePageSlug:"melissa-clark",name:"Melissa Clark",headshot:"https://static01.nyt.com/images/2024/01/30/dining/byline-headshot-melissa-clark/our-cooks-Melissa-Clark-Headshot-smallSquare252.png",bio:"Melissa Clark is a food reporter and columnist for The New York Times and NYT Cooking, for which she creates recipes, hosts videos and is one of the writers of the Cooking newsletter. She’s also written dozens of cookbooks. A native of Brooklyn, she knows where to find the best bagel.",socialMedia:[{type:"instagram",username:"clarkbar"}],website:"https://www.melissaclark.net/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"eric-kim",name:"Eric Kim",headshot:"https://static01.nyt.com/images/2023/03/22/multimedia/byline-headshot-eric-kim/ourcooks-eric-smallSquare252-v2.png",bio:"Eric Kim is a food columnist for The New York Times Magazine and a recipe developer and video host for NYT Cooking. A native of Atlanta, he is also the author of the cookbook “Korean American.”",socialMedia:[{type:"instagram",username:"ericjoonho"},{type:"twitter",username:"ericjoonho"},{type:"tiktok",username:"ericjoonho"}],website:"https://erickim.net/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"yewande-komolafe",name:"Yewande Komolafe",headshot:"https://static01.nyt.com/images/2024/01/30/multimedia/byline-headshot-yewande-komolafe/our-cooks-Yewande-Komolafe-studio-pkzv-smallSquare252.png",bio:"Yewande Komolafe is a cooking writer and columnist for The New York Times and a recipe developer and video host for NYT Cooking. She is also the author of the cookbook “My Everyday Lagos.”",socialMedia:[{type:"instagram",username:"yewande_komolafe"},{type:"twitter",username:"yewande_k"}],website:"https://www.yewandekomolafe.com/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"genevieve-ko",name:"Genevieve Ko",headshot:"https://static01.nyt.com/images/2023/03/21/multimedia/byline-headshot-genevieve-ko/ourcooks-genevieve-smallSquare252-v3.png",bio:"Genevieve Ko is a deputy editor of NYT Cooking and Food at The New York Times, where she also writes a column, develops recipes and appears in videos. In addition to writing her own cookbook, she has contributed to more than 20 cookbooks. Born and raised in East Los Angeles, she now lives in New York City and cooks dishes from everywhere.",socialMedia:[{type:"instagram",username:"genevieve_ko"},{type:"twitter",username:"genevieveko"}],website:"https://www.genevieveko.com/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"kenji-lopez-alt",name:"Kenji L\xf3pez-Alt",otherNames:["J. Kenji L\xf3pez-Alt"],headshot:"https://static01.nyt.com/images/2023/03/21/multimedia/byline-headshot-j-kenji-lopez-alt/ourcooks-jkenji-smallSquare252-v3.png",bio:"J. Kenji L\xf3pez-Alt writes a column for The New York Times on food and science, and he develops recipes and appears in videos for NYT Cooking. He is also the creator and host of Kenji’s Cooking Show on YouTube.",socialMedia:[{type:"instagram",username:"kenjilopezalt"},{type:"youtube",username:"JKenjiLopezAlt"},{type:"tiktok",username:"j.kenji.lopezalt"}],website:"https://www.kenjilopezalt.com/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"sohla-el-waylly",name:"Sohla El-Waylly",headshot:"https://static01.nyt.com/images/2024/01/01/dining/byline-headshot-sohla-el-waylly/our-cooks-Sohla-smallSquare252.png",bio:"Sohla El-Waylly is a food writer who develops recipes and hosts videos for NYT Cooking. She’s been featured on HBO Max, History Channel and the Bon App\xe9tit YouTube channel, and she’s also the author of the cookbook “Start Here.”",socialMedia:[{type:"instagram",username:"sohlae"},{type:"tiktok",username:"sohlae"}],website:"https://www.hellosohla.com/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"claire-saffitz",name:"Claire Saffitz",headshot:"https://static01.nyt.com/images/2024/01/25/dining/byline-headshot-claire-saffitz/ourcooks-Claire-Saffitz-headshot-2-smallSquare252.png",bio:"Claire Saffitz is a cookbook author, video host and recipe developer. Previously, Claire was a senior food editor at Bon App\xe9tit magazine, where she hosted the series “Gourmet Makes” on the Bon App\xe9tit YouTube channel. She currently hosts her own YouTube channel called Dessert Person.",socialMedia:[{type:"instagram",username:"csaffitz"},{type:"youtube",username:"CSaffitz"},{type:"tiktok",username:"csaffitz"}],showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"priya-krishna",name:"Priya Krishna",headshot:"https://static01.nyt.com/images/2023/03/21/multimedia/byline-headshot-priya-krishna/ourcooks-priya-smallSquare252-v4.png",bio:"Priya Krishna is a food reporter for The New York Times, and a recipe developer and video host for NYT Cooking. She is the author of multiple cookbooks, and her stories have been included in “The Best American Food Writing.” She is originally from Dallas.",socialMedia:[{type:"instagram",username:"priyakrishna"},{type:"twitter",username:"priyakrishna"}],website:"https://www.priyakrishna.me/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"vaughn-vreeland",name:"Vaughn Vreeland",headshot:"https://static01.nyt.com/images/2023/10/02/multimedia/byline-headshot-vaughn-vreeland/ourcooks-Vaughn-Vreeland-fqtw-smallSquare252.png",bio:"Vaughn Vreeland is a supervising video producer for NYT Cooking. An avid baker and home cook hailing from North Carolina, Vaughn can be seen making his latest creations on the NYT Cooking YouTube channel, Instagram and TikTok.",socialMedia:[{type:"instagram",username:"vaughn"},{type:"tiktok",username:"vaughnvreeland"}],showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"sam-sifton",name:"Sam Sifton",headshot:"https://static01.nyt.com/images/2019/11/29/multimedia/byline-headshot-sam-sifton/Headshot-Sam-Sifton-smallSquare252.png",bio:"Sam Sifton is the founding editor of NYT Cooking, and an assistant managing editor leading culture and lifestyle coverage for The New York Times. He’s also a cookbook author and one of the writers of the Cooking newsletter.",socialMedia:[{type:"instagram",username:"samsifton"},{type:"twitter",username:"SamSifton"}],website:"https://www.samsifton.com/",showOnAboutUsPage:!0},{bylinePageSlug:"emily-weinstein",name:"Emily Weinstein",headshot:"https://static01.nyt.com/images/2024/01/25/multimedia/byline-headshot-emily-weinstein/Headshot-Emily-Weinstein-gftb-smallSquare252.png",bio:"Emily Weinstein is the editor in chief of Cooking and Food at The New York Times, overseeing NYT Cooking, as well as The Times’s food journalism and restaurant reviews. She also writes the NYT Cooking newsletter Five Weeknight Dishes.",socialMedia:[{type:"instagram",username:"emweinstein"},{type:"twitter",username:"emilyweinstein"}],website:"https://www.emilyweinstein.com/",showOnAboutUsPage:!0},{bylinePageSlug:"tanya-sichynsky",name:"Tanya Sichynsky",headshot:"https://static01.nyt.com/images/2024/02/01/multimedia/byline-headshot-tanya-sichynsky/Tanya-Sichynsky-headshot-wkbt-smallSquare252.png",bio:"Tanya Sichynsky is a senior staff editor for The New York Times and NYT Cooking, and she writes the Veggie, NYT Cooking’s vegetarian newsletter. Tanya grew up in the Atlanta suburbs with a Cuban mother and a Ukrainian father, both of whom are from New York City.",socialMedia:[{type:"instagram",username:"tanyasic"},{type:"twitter",username:"tanyasic"}],showOnAboutUsPage:!0},{bylinePageSlug:"ali-slagle",name:"Ali Slagle",headshot:"https://static01.nyt.com/images/2024/02/05/dining/byline-headshot-ali-slagle/our-cooks-Ali-Slagle-Headshot-smallSquare252.png",bio:"Ali Slagle is a recipe developer and regular contributor to NYT Cooking who specializes in low-effort, high-reward recipes. She is also the author of the cookbook “I Dream of Dinner (so You Don’t Have To).”",socialMedia:[{type:"instagram",username:"itsalislagle"},{type:"twitter",username:"itsalislagle"}],website:"https://alislagle.com/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"kay-chun",name:"Kay Chun",headshot:"https://static01.nyt.com/images/2024/02/01/multimedia/byline-headshot-kay-chun/ourcooks-Kay-Chung-headshot-vgzq-smallSquare252.png",bio:"Kay Chun is a recipe developer and regular contributor to NYT Cooking. She has been a writer and editor at several food publications, including Food & Wine, Bon App\xe9tit, Gourmet and Real Simple. A native New Yorker, Kay is continually inspired by the city’s vast flavors.",socialMedia:[{type:"instagram",username:"thisiskaychun"}],showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"korsha-wilson",name:"Korsha Wilson",headshot:"https://static01.nyt.com/images/2024/05/20/dining/byline-headshot-korsha-wilson/byline-headshot-korsha-wilson-blog225.png",bio:"Korsha Wilson is a contributor to NYT Cooking and writes about food for The New York Times. She has also written for Bon App\xe9tit, Food & Wine and Eater, and she is the creator and host of A Hungry Society, a podcast that takes an inclusive look at the food world.",socialMedia:[{type:"instagram",username:"korshawilson"}],showOnAboutUsPage:!0},{bylinePageSlug:"yotam-ottolenghi",name:"Yotam Ottolenghi",headshot:"https://static01.nyt.com/images/2023/03/21/multimedia/byline-headshot-yotam-ottolenghi/ourcooks-yotam-smallSquare252-v2.png",bio:"Yotam Ottolenghi is a food columnist for The New York Times Magazine and the author of multiple cookbooks. He is the chef-owner of five Ottolenghi delis in London, as well as the NOPI and ROVI restaurants.",socialMedia:[{type:"instagram",username:"ottolenghi"},{type:"twitter",username:"ottolenghi"},{type:"youtube",username:"Ottolenghi"},{type:"tiktok",username:"ottolenghi"}],website:"https://ottolenghi.co.uk/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"david-tanis",name:"David Tanis",headshot:"https://static01.nyt.com/images/2023/03/22/multimedia/byline-headshot-david-tanis/ourcooks-david-smallSquare252-v2.png",bio:"David Tanis writes a monthly cooking column for The New York Times. Though he has had a long career as a chef, he has always been a passionate home cook, and is well known for serving simple, rustic food, family-style. He is also the author of several cookbooks featuring seasonal cooking.",socialMedia:[{type:"instagram",username:"david_tanis"},{type:"twitter",username:"DavidTanisCooks"}],website:"https://davidtanis.com",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"ligaya-mishan",name:"Ligaya Mishan",headshot:"https://static01.nyt.com/images/2023/03/21/multimedia/byline-headshot-ligaya-mishan/ourcooks-ligaya-smallSquare252-v3.png",bio:"Ligaya Mishan is a food columnist for The New York Times Magazine and a writer at large for T magazine. She has written for the New York Review of Books and The New Yorker, and her work has appeared in the Best American anthologies in Magazine, Food and Travel Writing. The daughter of a Filipino mother and a British father, she grew up in Honolulu.",socialMedia:[{type:"instagram",username:"ligayamishan"},{type:"twitter",username:"ligayamishan"}],showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"lisa-donovan",name:"Lisa Donovan",headshot:"https://static01.nyt.com/images/2024/01/25/multimedia/byline-headshot-lisa-donovan/ourcooks-Lisa-Donovan-color-wqbp-smallSquare252.png",bio:"Lisa Donovan is a food columnist for The New York Times Magazine. An award-winning writer and pastry chef, she has worked with some of the South’s most influential chefs. Lisa’s recipes and writing have also appeared in Bon App\xe9tit, Food & Wine, The Washington Post and other publications.",socialMedia:[{type:"instagram",username:"lisamariedonovan"}],website:"https://www.lisamariedonovan.com/",showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"alexa-weibel",name:"Alexa Weibel",headshot:"https://static01.nyt.com/images/2023/10/02/multimedia/byline-headshot-alexa-weibel/ourcooks-Alexa-Weibel-kqlw-smallSquare252.png",bio:"Alexa Weibel is a senior staff editor and recipe developer at NYT Cooking, and she was previously an editor at Rachael Ray magazine and a restaurant line cook. Born in Paris, she’s inclined to add extra butter, but she also enjoys exploring the challenges of vegan, budget and weeknight cooking.",socialMedia:[{type:"instagram",username:"alexaweibel"},{type:"twitter",username:"alexaweibel"}],showOnAboutUsPage:!0,showOnCarousel:!0},{bylinePageSlug:"christina-morales",name:"Christina Morales",headshot:"https://static01.nyt.com/images/2024/01/02/dining/byline-headshot-christina-morales/Headshot-Christina-Morales-smallSquare252.png",bio:"Christina Morales is a food reporter for the The New York Times who also publishes recipes on NYT Cooking. Christina was born to a Cuban family in the Miami area, and her abuela’s home-cooked meals, which greeted her after school, fueled her passion for writing about Latin American food.",socialMedia:[{type:"instagram",username:"christina_a_morales"},{type:"twitter",username:"christina_m18"}],website:"https://christina-morales.com/",showOnAboutUsPage:!0},{bylinePageSlug:"julia-moskin",name:"Julia Moskin",headshot:"https://static01.nyt.com/images/2024/02/01/multimedia/byline-headshot-julia-moskin/Julia-Moskin-Headshot-vhzl-smallSquare252.png",bio:"Julia Moskin, a lifelong New Yorker, is a Pulitzer Prize-winning food reporter for The New York Times. She also contributes recipes to NYT Cooking.",socialMedia:[{type:"instagram",username:"juliamoskin"},{type:"twitter",username:"juliamoskin"}],showOnAboutUsPage:!0},{bylinePageSlug:"kim-severson",name:"Kim Severson",headshot:"https://static01.nyt.com/images/2024/01/02/multimedia/byline-headshot-kim-severson/Headshot-Kim-Severson-hfjp-smallSquare252.png",bio:"Kim Severson is a Pulitzer Prize-winning food reporter for The New York Times. She’s written about all aspects of food, from kitchens to courtrooms. She now lives in Atlanta and travels the country looking for news and recipes for NYT Cooking.",socialMedia:[{type:"instagram",username:"kimseverson"},{type:"twitter",username:"kimseverson"}],website:"https://www.kimseverson.com/",showOnAboutUsPage:!0},{bylinePageSlug:"bryan-washington",name:"Bryan Washington",headshot:"https://static01.nyt.com/images/2024/02/09/dining/byline-headshot-bryan-washington/byline-headshot-bryan-washington-smallSquare252.png",bio:"Bryan Washington is a columnist for The New York Times Magazine. He’s a National Book Foundation 5 Under 35 Honoree, a recipient of the International Dylan Thomas Prize, the New York Public Library’s Young Lions Award, the Lambda Literary Award, and an O. Henry Award. He was also a finalist for the National Book Critics Circle Award for Fiction, the National Book Critics Circle John Leonard Prize, and the Andrew Carnegie Medal of Excellence.",socialMedia:[{type:"instagram",username:"bry.washing"}]},{bylinePageSlug:"florence-fabricant",name:"Florence Fabricant",headshot:"https://static01.nyt.com/images/2024/02/09/dining/byline-headshot-florence-fabricant/byline-headshot-florence-fabricant-smallSquare252.png",bio:"Florence Fabricant is a longtime and long-acclaimed contributor to the Food section. She is the author of 13 cookbooks, including “The Ladies’ Village Improvement Society Cookbook,” “The New York Times Seafood Cookbook,” “The New York Times Dessert Cookbook,” “Park Avenue Potluck” and, with Eric Asimov, “Wine With Food: Pairing Notes and Recipes From The New York Times.”"},{bylinePageSlug:"tejal-rao",name:"Tejal Rao",bio:"Tejal Rao is the California restaurant critic at The New York Times and writes The Veggie newsletter. She lives in Los Angeles and was awarded a Vilcek Prize for her reporting in 2019. Her work has been included in two editions of “The Best American Food Writing,” and she has won two James Beard awards for restaurant criticism.",socialMedia:[{type:"instagram",username:"tejalxrao"}]},{bylinePageSlug:"gabrielle-hamilton",name:"Gabrielle Hamilton",bio:"Gabrielle Hamilton is a columnist for The New York Times Magazine and the chef and owner of Prune. She is also the author of a memoir, “Blood, Bones and Butter: The Inadvertent Education of a Reluctant Chef.”"},{bylinePageSlug:"dorie-greenspan",name:"Dorie Greenspan",bio:"Dorie Greenspan is a columnist for The New York Times Magazine. She’s written 13 cookbooks, including “Baking From My Home to Yours,” “Dorie’s Cookies” and “Everyday Dorie,” and won five James Beard awards for her books and writing.",socialMedia:[{type:"instagram",username:"doriegreenspan"}]},{bylinePageSlug:"aaron-hutcherson",name:"Aaron Hutcherson"},{bylinePageSlug:"adeena-sussman",name:"Adeena Sussman"},{bylinePageSlug:"aglaia-kremezi",name:"Aglaia Kremezi"},{bylinePageSlug:"alex-ward",name:"Alex Ward"},{bylinePageSlug:"alex-witchel",name:"Alex Witchel"},{bylinePageSlug:"alice-hart",name:"Alice Hart"},{bylinePageSlug:"alice-waters",name:"Alice Waters"},{bylinePageSlug:"alison-roman",name:"Alison Roman"},{bylinePageSlug:"amanda-hesser",name:"Amanda Hesser"},{bylinePageSlug:"amelia-nierenberg",name:"Amelia Nierenberg"},{bylinePageSlug:"ana-sortun",name:"Ana Sortun"},{bylinePageSlug:"andrea-nguyen",name:"Andrea Nguyen"},{bylinePageSlug:"angela-dimayuga",name:"Angela Dimayuga"},{bylinePageSlug:"ann-barry",name:"Ann Barry"},{bylinePageSlug:"anna-francese-gass",name:"Anna Francese Gass"},{bylinePageSlug:"anthony-bourdain",name:"Anthony Bourdain"},{bylinePageSlug:"barbara-kafka",name:"Barbara Kafka"},{bylinePageSlug:"barbara-lynch",name:"Barbara Lynch"},{bylinePageSlug:"becky-hughes",name:"Becky Hughes"},{bylinePageSlug:"betty-fussell",name:"Betty Fussell"},{bylinePageSlug:"bill-yosses",name:"Bill Yosses"},{bylinePageSlug:"bobby-flay",name:"Bobby Flay"},{bylinePageSlug:"brett-anderson",name:"Brett Anderson"},{bylinePageSlug:"brigid-washington",name:"Brigid Washington"},{bylinePageSlug:"bryan-miller",name:"Bryan Miller"},{bylinePageSlug:"bryan-washington",name:"Bryan Washington"},{bylinePageSlug:"carolina-gelen",name:"Carolina Gelen"},{bylinePageSlug:"cathy-barrow",name:"Cathy Barrow"},{bylinePageSlug:"cathy-erway",name:"Cathy Erway"},{bylinePageSlug:"cathy-lo",name:"Cathy Lo"},{bylinePageSlug:"celia-barbour",name:"Celia Barbour"},{bylinePageSlug:"charlotte-druckman",name:"Charlotte Druckman"},{bylinePageSlug:"chris-schlesinger",name:"Chris Schlesinger"},{bylinePageSlug:"christian-reynoso",name:"Christian Reynoso"},{bylinePageSlug:"christine-muhlke",name:"Christine Muhlke"},{bylinePageSlug:"christopher-idone",name:"Christopher Idone"},{bylinePageSlug:"clare-de-boer",name:"Clare de Boer"},{bylinePageSlug:"clarissa-wei",name:"Clarissa Wei"},{bylinePageSlug:"colette-rossant",name:"Colette Rossant"},{bylinePageSlug:"colu-henry",name:"Colu Henry"},{bylinePageSlug:"corby-kummer",name:"Corby Kummer"},{bylinePageSlug:"craig-claiborne",name:"Craig Claiborne"},{bylinePageSlug:"daisann-mclane",name:"Daisann McLane"},{bylinePageSlug:"dan-pelosi",name:"Dan Pelosi"},{bylinePageSlug:"dana-bowen",name:"Dana Bowen"},{bylinePageSlug:"daniel-boulud",name:"Daniel Boulud"},{bylinePageSlug:"daniel-patterson",name:"Daniel Patterson"},{bylinePageSlug:"daniela-galarza",name:"Daniela Galarza"},{bylinePageSlug:"darun-kwak",name:"Darun Kwak"},{bylinePageSlug:"david-chang",name:"David Chang"},{bylinePageSlug:"david-latt",name:"David Latt"},{bylinePageSlug:"david-wondrich",name:"David Wondrich"},{bylinePageSlug:"dawn-perry",name:"Dawn Perry"},{bylinePageSlug:"deborah-madison",name:"Deborah Madison"},{bylinePageSlug:"dena-kleiman",name:"Dena Kleiman"},{bylinePageSlug:"dorie-greenspan",name:"Dorie Greenspan"},{bylinePageSlug:"edna-lewis",name:"Edna Lewis"},{bylinePageSlug:"eileen-yin-fei-lo",name:"Eileen Yin-Fei Lo"},{bylinePageSlug:"elaine-louie",name:"Elaine Louie"},{bylinePageSlug:"elaine-sciolino",name:"Elaine Sciolino"},{bylinePageSlug:"eleanore-park",name:"Eleanore Park"},{bylinePageSlug:"emily-fleischaker",name:"Emily Fleischaker"},{bylinePageSlug:"enid-nemy",name:"Enid Nemy"},{bylinePageSlug:"eric-asimov"